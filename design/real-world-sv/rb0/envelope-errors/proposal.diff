+def _slang_error_list(comp, sm):
+    """The ERROR diagnostics of the default-point compilation (parse, preprocessor, elaboration: what
+    `getAllDiagnostics()` holds; the analysis pass has its own list): `(code, message, line, col)`,
+    sorted, duplicates removed. Fails closed: if the list cannot be built the error is `FrontendFailed`."""
+    try:
+        engine = _slang_driver().diagEngine
+        found = set()
+        for d in comp.getAllDiagnostics():
+            if not d.isError():
+                continue
+            try:
+                where = "%s:%s" % (os.path.basename(str(sm.getFileName(d.location))), sm.getLineNumber(d.location))
+                line, col = sm.getLineNumber(d.location), sm.getColumnNumber(d.location)
+            except Exception:
+                where, line, col = "?", None, None
+            found.add((_slang_diag_name(d), "%s: %s" % (where, " ".join(engine.formatMessage(d).split())), line, col))
+        return sorted(found, key=lambda f: (f[2] or 0, f[3] or 0, f[0], f[1]))
+    except Exception as exc:  # noqa: BLE001
+        return [("FrontendFailed", "slang's diagnostics could not be listed: %s: %s"
+                 % (type(exc).__name__, str(exc)[:200]), None, None)]
+
+
+def _slang_error_nodes(errors):
+    """One `Unsupported` per slang error, kind `SlangError:<slang code>` (the twin of `SlangAnalysis:<code>`)."""
+    nodes = []
+    for code, message, line, col in errors[:20]:
+        node = unsupported(None, None, "SlangError:" + code, message[:UNSUPPORTED_TEXT_LIMIT])
         if line is not None:
             node["span"] = {"line": line, "col": col, "end_line": line, "end_col": col}
         nodes.append(node)
     return nodes
 
 

import Spec

/-! More golden vectors for the draft `keccak_round` statement (see `Spec.lean`): the last round of each
standard width from the XKCP intermediate-value files, and the first round of the permutation inside SHA3-256(""). -/

namespace SvGolf.Tasks.KeccakRound
open SvGolf

/-- xkcp KeccakF-400-IntermediateValues example 0 round 19. -/
theorem xkcp_w16_round19 :
    (task.fn 16 (0xa72a93fd51dca150c5138c429e2ed4877406d264bea39714db5de3d4abf35891ea0b46a200061363cd9efe562f960498ca00#400,
      0x000a#16, ())).1 =
      0xb38e714c71ff58ee633e6e146d955d8159a15246e7760ec9dc7560520337bf8feff078705bd1eca0e89f14f50fa940ac09f5#400 := by
  decide +kernel

/-- xkcp KeccakF-800-IntermediateValues example 0 round 21. -/
theorem xkcp_w32_round21 :
    (task.fn 32 (0xdd396bb2f33f75595e5af6f42338f395ae8ca0f4dea3d8867a6897a4cf5eadd3f58aee51381aa49673b6b17a124427f1f4bfa79852d399c9f1fc9b87ac3b577bebd2f3d875ecf62b1ab35560ff72a978c3eb8e3511f176959683b98f13298202e2980002#800,
      0x00008080#32, ())).1 =
      0x11efe99687b28070930a0e764119eff334001a98e74b1015afab8d68ab659687a3970a1f1a9e599a6166fa911bf4fc0eb15cd0549f68588488172715227a2424bf5af34caf973664f00b80a7e539f57851ffd042f1f8452f23a0bf99f404c6fbe531d45d#800 := by
  decide +kernel

/-- xkcp KeccakF-1600-IntermediateValues example 0 round 2. -/
theorem xkcp_w64_round2 :
    (task.fn 64 (#1600,
      0x800000000000808a#64, ())).1 =
      #1600 := by
  decide +kernel

/-- xkcp KeccakF-1600-IntermediateValues example 0 round 23. -/
theorem xkcp_w64_round23 :
    (task.fn 64 (#1600,
      0x8000000080008008#64, ())).1 =
      #1600 := by
  decide +kernel

/-- sha3: round 0 of the permutation inside SHA3-256(''); the 24 rounds' composition equals hashlib.sha3_256. -/
theorem sha3_256_empty_round0 :
    (task.fn 64 (#1600,
      0x0000000000000001#64, ())).1 =
      #1600 := by
  decide +kernel

end SvGolf.Tasks.KeccakRound
